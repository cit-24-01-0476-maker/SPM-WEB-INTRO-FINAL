# ---------------------------------------------------------------------------
# SPM ECO System — environment variables
#
# Copy this file to `.env` for local development and set the same values in
# Vercel → Project → Settings → Environment Variables (Development, Preview,
# and Production). Never commit real values.
# ---------------------------------------------------------------------------

# --- Firebase Web (client, publishable) ------------------------------------
# Safe for the browser — security is enforced by Firebase Auth + Firestore
# Security Rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Realtime Database URL — REQUIRED for live-visitor presence.
# Find it in Firebase Console → Realtime Database (e.g.
# https://<project>-default-rtdb.firebaseio.com). If unset, the public site and
# historical Firestore analytics still work; only live presence is disabled.
VITE_FIREBASE_DATABASE_URL=

# Optional: Firebase Analytics (GA4) measurement id for historical traffic.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: reCAPTCHA v3 site key to enable Firebase App Check in the browser.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# --- Analytics (server-only) -----------------------------------------------
# Salt used to derive non-reversible visitor hashes from IP addresses in the
# /api/public/visitor-context endpoint. Raw IPs are never stored or returned.
# NEVER use the VITE_ prefix — this must stay server-side only.
ANALYTICS_HASH_SALT=

# --- Google Drive (server-only, OPTIONAL) ----------------------------------
# Required ONLY for Google Drive upload mode in the Media Library. The rest of
# the admin panel works without these. NEVER use the VITE_ prefix here — these
# must never reach the browser bundle.
#
# Service-account style:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
#
# OAuth style (use ONE style, not both):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Email notifications (server-only, OPTIONAL) ---------------------------
# Powers new-inquiry email notifications via Resend. If unset, inquiries are
# still saved to Firestore — only the email step is skipped. NEVER use VITE_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAILS=
